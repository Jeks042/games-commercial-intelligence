        "measures": [
          {
            "name": "Dated GBP price",
            "expression": "IF(COUNTROWS('Portfolio') = 1, SELECTEDVALUE('Portfolio'[final_price_gbp]))",
            "formatString": "£0.00",
            "lineageTag": "2b2e5811-85ee-5529-965c-7541f1f9cc62"
          },
          {
            "name": "Lifetime positive share",
            "expression": "IF(COUNTROWS('Portfolio') = 1, DIVIDE(SELECTEDVALUE('Portfolio'[lifetime_review_positive_percent]), 100))",
            "formatString": "0.0%",
            "lineageTag": "ee469926-b250-52a0-8797-6321a2208bba"
          },
          {
            "name": "Point concurrent players",
            "expression": "IF(COUNTROWS('Portfolio') = 1, SELECTEDVALUE('Portfolio'[current_players]))",
            "formatString": "#,0",
            "lineageTag": "2de04bb5-bc93-5bc2-8025-67cdfe2cec34"
          },
          {
            "name": "Lifetime review count",
            "expression": "IF(COUNTROWS('Portfolio') = 1, SELECTEDVALUE('Portfolio'[total_reviews]))",
            "formatString": "#,0",
            "lineageTag": "b74ce8ba-a21e-59be-8994-dbe034bda256"
          },
          {
            "name": "Snapshot discount",
            "expression": "IF(COUNTROWS('Portfolio') = 1, DIVIDE(SELECTEDVALUE('Portfolio'[discount_depth_percent]), 100))",
            "formatString": "0.0%",
            "lineageTag": "4f5bb990-c3b9-5747-8055-ebf9be669514"
          }
        ],
        "partitions": [
          {
            "name": "Portfolio",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source = Table.FromRecords(Json.Document(Binary.FromText(\"\", BinaryEncoding.Base64))),",
                " Typed = Table.TransformColumnTypes(Source, {{\"app_id\", Int64.Type}, {\"title\", type text}, {\"peer_group\", type text}, {\"run_id\", type text}, {\"steam_store_retrieved_at_utc\", type text}, {\"steam_reviews_retrieved_at_utc\", type text}, {\"current_players_retrieved_at_utc\", type text}, {\"analytical_lifecycle\", type text}, {\"title_age_days\", Int64.Type}, {\"early_access_genre_flag\", Int64.Type}, {\"list_price_gbp\", type number}, {\"final_price_gbp\", type number}, {\"discount_depth_percent\", type number}, {\"total_reviews\", Int64.Type}, {\"lifetime_review_positive_percent\", type number}, {\"current_players\", Int64.Type}, {\"direct_peer_count\", Int64.Type}, {\"context_reference_count\", Int64.Type}, {\"player_change_3weeks_percent\", type text}, {\"player_momentum_status\", type text}, {\"review_velocity_per_day\", type text}, {\"review_velocity_status\", type text}, {\"engagement_depth_status\", type text}, {\"ownership_analysis_status\", type text}, {\"sustained_activity_status\", type text}, {\"overall_performance_classification\", type text}, {\"evidence_class\", type text}, {\"analytical_lifecycle_label\", type text}, {\"player_momentum_status_label\", type text}, {\"review_velocity_status_label\", type text}, {\"engagement_depth_status_label\", type text}, {\"ownership_analysis_status_label\", type text}, {\"sustained_activity_status_label\", type text}})",
                "in",
                " Typed"
              ]
            }
          }
        ]
