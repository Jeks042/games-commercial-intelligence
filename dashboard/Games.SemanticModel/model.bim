            "expression": "IF(COUNTROWS('Scenarios') = 1, SELECTEDVALUE('Scenarios'[conditional_gross_receipts_index]))",
            "formatString": "0.0",
            "lineageTag": "fe2e3fb3-a08a-5249-9c00-1f262d68bf8a"
          },
          {
            "name": "Required unit increase",
            "expression": "IF(COUNTROWS('Scenarios') = 1, DIVIDE(SELECTEDVALUE('Scenarios'[required_paid_unit_change_percent]), 100))",
            "formatString": "0.0%",
            "lineageTag": "62a6ee6e-dcad-55f6-8371-d776638fd0ce"
          },
          {
            "name": "Separate engagement index",
            "expression": "IF(COUNTROWS('Scenarios') = 1, SELECTEDVALUE('Scenarios'[hypothetical_engagement_index]))",
            "formatString": "0.0",
            "lineageTag": "d41163b2-94b7-5796-bed2-4d12458048af"
          }
        ],
